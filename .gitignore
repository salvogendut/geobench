# Build artifacts
*.bin
*.BIN
*.RAW
bin/
build/
# CPC disk images
*.dsk
*.DSK

# Assembler / build intermediates
*.o
*.lst
*.sym
*.map
rom/gitcommit.inc          # generated by tools/build_rom.sh (git commit -> ROM boot banner)

# Emulator screenshots (1984 F4 dumps)
*.ppm

# Python artifacts
__pycache__/
*.pyc

# Editor / OS cruft
*~
.DS_Store

# The staged distribution QA/ IS shipped in the repo (ready-to-deploy QA/CARD/ +
# QA/GEOBENCH.DSK), so re-include it despite the *.BIN/*.DSK/*.RAW ignores above.
# Regenerate with `bash tools/build_kernel.sh`.
!QA/**
# ...except the 32MB card image: it is rebuilt (and byte-churns) on every build, so it
# is a local build artifact, not committed. Build it with tools/build_card_img.sh.
QA/GEOBENCH.IMG
rom/GEOBENCH.ROM
rom/GBALB.ROM
